{
  "theme": "Dark Luxury Corporate",
  "app_type": "marketing_site",
  "typography": {
    "headings": {
      "family": "Plus Jakarta Sans",
      "weights": ["400", "600", "700", "800"],
      "classes": "font-sans tracking-tight"
    },
    "body": {
      "family": "Inter",
      "weights": ["400", "500", "600"],
      "classes": "font-body leading-relaxed"
    }
  },
  "colors": {
    "primary_bg": "#101E30",
    "secondary_bg": "#1C3552",
    "accent_gold": "#D5A94F",
    "light_bg": "#F5F7FA",
    "secondary_text": "#8A96A5",
    "white": "#FFFFFF"
  },
  "visual_enhancers": {
    "overlay": "bg-[#101E30]/70 to bg-[#101E30]/90 for hero overlay",
    "glassmorphism": "Avoid excessive glassmorphism. Use solid navy (#1C3552) or subtle borders.",
    "shadows": "Deep, layered shadows for cards on light backgrounds, subtle glow for gold accents on dark.",
    "borders": "1px solid border-[#8A96A5]/20 or border-[#D5A94F]/30 for structure"
  },
  "layouts": {
    "overall": "Alternating dark and light sections (editorial approach). Dark navy dominant.",
    "about": "Asymmetric editorial layout. Large image alongside small supporting image, with strong typographic hierarchy.",
    "services": "Clear separation of categories, image-supported, different compositions per service.",
    "industries": "Large editorial image cards with hover reveals."
  },
  "motion": {
    "scroll": "Smooth scroll (Lenis), scroll-triggered transitions.",
    "entrance": "Cinematic hero entrance, image reveals with subtle scale-up, staggered count-up stats.",
    "hover": "Hover state on services (reveals positions), industry cards lift and brighten.",
    "accessibility": "Respect prefers-reduced-motion."
  },
  "3d_libraries": {
    "globe": "react-three-fiber (R3F) or react-globe.gl. Interactive 3D globe with Gulf highlight + arcs. Destinations vs Offices distinct. Static map fallback for mobile."
  },
  "component_path": "/app/frontend/src/components/ui",
  "instructions_to_main_agent": [
    "Build out the 12 specified sections exactly in order: 01 Hero, 02 Stats, 03 About, 04 Why Choose, 05 Services, 06 Industries, 07 Process, 08 Global Presence, 09 Clients, 10 Team, 11 Contact, 12 Footer.",
    "No generic AI layouts or excessive rounded cards. Keep radii minimal (0px-4px) for a corporate structural feel.",
    "No unnecessary gradients. Use solid colors and high-quality photography.",
    "Do not invent facts (no email, no social accounts, no non-provided logos).",
    "Both Employer and Candidate forms must NOT submit via standard API, they must construct a WhatsApp message URL to +91 98210 90453 and open it in a new tab.",
    "The Hero background must ONLY be the provided `/brand/hero.jpg` with a strong navy overlay so white text is readable.",
    "Use white logos (`/brand/logo-white.png` & `/brand/logo-white-mark.png`) on dark sections, color logos (`/brand/logo-color.png` & `/brand/logo-color-mark.png`) on light sections.",
    "Alternate section backgrounds between `#101E30`, `#1C3552`, and `#F5F7FA`.",
    "Use Lucide React for icons.",
    "Apply Framer Motion for entrance animations and the interactive timeline."
  ],
  "UNIVERSAL GUIDELINES FOR MAIN AGENT": [
    "Do not center-align the app container. Keep natural text flow (left-aligned predominantly).",
    "Create depth through layered z-index rather than cheap gradients.",
    "No emoji characters for icons.",
    "Ensure minimum 4.5:1 contrast ratio. Use Text Shadow where needed on hero images.",
    "Ensure the header background transitions from transparent over the hero to solid navy on scroll.",
    "Use pill-shaped or sharp modern buttons for CTAs. Gold (#D5A94F) for primary actions.",
    "All interactive elements MUST include a data-testid attribute in kebab-case."
  ],
